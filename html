<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="theme-color" content="#f5f7fa">
    <meta name="format-detection" content="telephone=no">
    <title>高级颜值测试系统</title>
    <style>
        :root {
            --primary: #4a5568;
            --secondary: #718096;
            --accent: #a0aec0;
            --success: #48bb78;
            --warning: #ed8936;
            --danger: #f56565;
            --dark: #2d3748;
            --light: #f7fafc;
            --gray: #718096;
            --card-bg: #ffffff;
            --section-bg: #f8f9fa;
            --border: #e2e8f0;
            
            /* 五行颜色 */
            --metal: #c0c0c0;
            --wood: #228B22;
            --water: #1E90FF;
            --fire: #FF4500;
            --earth: #CD853F;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
            -webkit-font-smoothing: antialiased;
        }
        
        body {
            background: linear-gradient(135deg, #edf2f7 0%, #e2e8f0 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            color: var(--dark);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol';
            line-height: 1.5;
        }
        
        .container {
            width: 100%;
            max-width: 1100px;
            background-color: var(--card-bg);
            border-radius: 20px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            animation: fadeIn 0.8s ease-out;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        header {
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            color: white;
            padding: 40px 30px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        
        header::before {
            content: "";
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 70%);
            transform: rotate(30deg);
        }
        
        h1 {
            font-size: clamp(1.8rem, 5vw, 2.8rem);
            margin-bottom: 15px;
            font-weight: 800;
            position: relative;
            text-shadow: 0 2px 10px rgba(0,0,0,0.2);
        }
        
        .subtitle {
            font-size: clamp(0.9rem, 3vw, 1.1rem);
            opacity: 0.9;
            max-width: 700px;
            margin: 0 auto;
            line-height: 1.6;
            position: relative;
        }
        
        .main-content {
            padding: clamp(20px, 4vw, 40px);
        }
        
        .welcome-section {
            text-align: center;
            margin-bottom: 40px;
            padding: clamp(20px, 4vw, 40px) clamp(15px, 3vw, 30px);
            background: var(--section-bg);
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.03);
            border: 1px solid var(--border);
        }
        
        .welcome-title {
            font-size: clamp(1.4rem, 4vw, 1.8rem);
            margin-bottom: 20px;
            color: var(--primary);
            font-weight: 700;
        }
        
        .welcome-text {
            color: var(--gray);
            font-size: clamp(0.9rem, 2.5vw, 1rem);
            line-height: 1.6;
            max-width: 600px;
            margin: 0 auto;
        }
        
        .upload-area {
            border: 3px dashed var(--border);
            border-radius: 18px;
            padding: clamp(30px, 6vw, 50px) clamp(20px, 4vw, 30px);
            text-align: center;
            margin-bottom: 40px;
            transition: all 0.4s;
            cursor: pointer;
            background-color: var(--section-bg);
            position: relative;
            overflow: hidden;
            touch-action: manipulation;
        }
        
        .upload-area.active {
            border-color: var(--primary);
            background-color: #f1f5f9;
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
        }
        
        .upload-area::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            transform: scaleX(0);
            transition: transform 0.4s;
        }
        
        .upload-area:hover::before,
        .upload-area.active::before {
            transform: scaleX(1);
        }
        
        .upload-icon {
            font-size: clamp(50px, 10vw, 70px);
            color: var(--primary);
            margin-bottom: 20px;
            display: block;
        }
        
        .upload-text {
            font-size: clamp(1.1rem, 3.5vw, 1.4rem);
            margin-bottom: 15px;
            color: var(--dark);
            font-weight: 600;
        }
        
        .upload-hint {
            color: var(--gray);
            font-size: clamp(0.85rem, 2.5vw, 1rem);
            line-height: 1.5;
            margin-top: 10px;
        }
        
        .upload-requirements {
            background: rgba(74, 85, 104, 0.05);
            border-radius: 10px;
            padding: 15px;
            margin-top: 20px;
            text-align: left;
        }
        
        .upload-requirements h4 {
            color: var(--primary);
            margin-bottom: 10px;
            font-size: clamp(0.95rem, 2.5vw, 1.1rem);
        }
        
        .upload-requirements ul {
            padding-left: 20px;
        }
        
        .upload-requirements li {
            margin-bottom: 8px;
            color: var(--gray);
            font-size: clamp(0.8rem, 2.2vw, 0.95rem);
        }
        
        #image-input {
            display: none;
        }
        
        .preview-container {
            display: none;
            text-align: center;
            margin-bottom: 40px;
            animation: slideUp 0.5s ease-out;
        }
        
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        #image-preview {
            max-width: min(320px, 80vw);
            max-height: min(320px, 80vw);
            border-radius: 15px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
            border: 5px solid white;
        }
        
        .analyze-btn {
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            color: white;
            border: none;
            padding: clamp(15px, 3.5vw, 18px) clamp(30px, 7vw, 50px);
            font-size: clamp(1rem, 3vw, 1.2rem);
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 7px 20px rgba(74, 85, 104, 0.25);
            margin: 0 auto;
            display: block;
            font-weight: 600;
            letter-spacing: 0.5px;
            position: relative;
            overflow: hidden;
            touch-action: manipulation;
            -webkit-appearance: none;
        }
        
        .analyze-btn::before {
            content: "";
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
            transition: left 0.7s;
        }
        
        .analyze-btn:hover, .analyze-btn:active {
            transform: translateY(-4px);
            box-shadow: 0 12px 25px rgba(74, 85, 104, 0.35);
        }
        
        .analyze-btn:hover::before {
            left: 100%;
        }
        
        .loading {
            display: none;
            text-align: center;
            margin: 40px 0;
            animation: fadeIn 0.5s;
        }
        
        .spinner {
            width: 70px;
            height: 70px;
            border: 6px solid #f0f0f0;
            border-top: 6px solid var(--primary);
            border-radius: 50%;
            animation: spin 1.2s linear infinite;
            margin: 0 auto 25px;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        .loading-text {
            font-size: clamp(1rem, 3vw, 1.2rem);
            color: var(--dark);
            font-weight: 500;
        }
        
        .loading-dots::after {
            content: '';
            animation: dots 1.5s steps(5, end) infinite;
        }
        
        @keyframes dots {
            0%, 20% { content: '.'; }
            40% { content: '..'; }
            60%, 100% { content: '...'; }
        }
        
        .result-container {
            display: none;
            margin-top: 30px;
            animation: fadeInUp 0.7s ease-out;
        }
        
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .result-header {
            text-align: center;
            margin-bottom: 40px;
        }
        
        .result-title {
            font-size: clamp(1.6rem, 4.5vw, 2.2rem);
            margin-bottom: 10px;
            color: var(--dark);
            font-weight: 700;
            position: relative;
            display: inline-block;
        }
        
        .result-title::after {
            content: "";
            position: absolute;
            bottom: -10px;
            left: 10%;
            width: 80%;
            height: 3px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            border-radius: 3px;
        }
        
        .score-display {
            font-size: clamp(3rem, 10vw, 5rem);
            font-weight: 800;
            color: var(--primary);
            margin: 25px 0;
            text-shadow: 0 5px 15px rgba(74, 85, 104, 0.15);
        }
        
        .score-bar-container {
            margin: 30px auto;
            max-width: 500px;
            width: 90%;
        }
        
        .score-labels {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 0.9rem;
            color: var(--gray);
        }
        
        .score-bar {
            height: 24px;
            background-color: #e9ecef;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.05);
        }
        
        .score-fill {
            height: 100%;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            border-radius: 12px;
            width: 0%;
            transition: width 1.8s cubic-bezier(0.22, 0.61, 0.36, 1);
            position: relative;
            overflow: hidden;
        }
        
        .score-fill::after {
            content: "";
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
            animation: shimmer 2s infinite;
        }
        
        @keyframes shimmer {
            0% { left: -100%; }
            100% { left: 100%; }
        }
        
        .analysis-sections {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
            gap: 30px;
            margin-top: 40px;
        }
        
        .analysis-section {
            background: var(--section-bg);
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.03);
            border: 1px solid var(--border);
        }
        
        .section-title {
            font-size: clamp(1.2rem, 3.5vw, 1.4rem);
            margin-bottom: 20px;
            color: var(--primary);
            font-weight: 700;
            display: flex;
            align-items: center;
        }
        
        .feature-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 15px;
        }
        
        .feature-item {
            margin-bottom: 15px;
        }
        
        .feature-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 5px;
        }
        
        .feature-name {
            font-weight: 600;
            color: var(--dark);
            font-size: clamp(0.85rem, 2.5vw, 1rem);
        }
        
        .feature-score {
            font-weight: 700;
            color: var(--primary);
            font-size: clamp(0.85rem, 2.5vw, 1rem);
        }
        
        .feature-bar {
            height: 8px;
            background-color: #e9ecef;
            border-radius: 4px;
            overflow: hidden;
        }
        
        .feature-fill {
            height: 100%;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            border-radius: 4px;
            width: 0%;
            transition: width 1.5s ease-out;
        }
        
        .feature-analysis {
            font-size: clamp(0.8rem, 2.2vw, 0.9rem);
            color: var(--gray);
            margin-top: 5px;
            line-height: 1.4;
        }
        
        .type-analysis {
            background: var(--section-bg);
            border: 1px solid var(--border);
            padding: 25px;
            border-radius: 15px;
            margin-top: 30px;
            text-align: center;
        }
        
        .type-title {
            font-size: clamp(1.3rem, 4vw, 1.6rem);
            margin-bottom: 15px;
            color: var(--primary);
            font-weight: 700;
        }
        
        .type-tag {
            display: inline-block;
            background: linear-gradient(135deg, var(--accent) 0%, #8a9aad 100%);
            color: white;
            padding: 8px 20px;
            border-radius: 50px;
            font-weight: 600;
            margin-bottom: 20px;
            font-size: clamp(1rem, 3vw, 1.2rem);
        }
        
        .type-description {
            font-size: clamp(0.95rem, 2.8vw, 1.1rem);
            line-height: 1.6;
            color: var(--dark);
            margin-bottom: 20px;
        }
        
        .type-features {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 20px;
        }
        
        .type-feature {
            background-color: white;
            padding: 8px 15px;
            border-radius: 50px;
            font-size: clamp(0.8rem, 2.2vw, 0.9rem);
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
            color: var(--dark);
            border: 1px solid var(--border);
        }
        
        /* 五行美人分析区域 */
        .five-element-analysis {
            background: var(--section-bg);
            border: 1px solid var(--border);
            padding: 25px;
            border-radius: 15px;
            margin-top: 30px;
            text-align: center;
        }
        
        .five-element-title {
            font-size: clamp(1.3rem, 4vw, 1.6rem);
            margin-bottom: 15px;
            color: var(--primary);
            font-weight: 700;
        }
        
        .element-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            margin: 20px 0;
            border: 2px solid transparent;
            transition: all 0.3s ease;
        }
        
        .element-card.metal {
            border-color: var(--metal);
        }
        
        .element-card.wood {
            border-color: var(--wood);
        }
        
        .element-card.water {
            border-color: var(--water);
        }
        
        .element-card.fire {
            border-color: var(--fire);
        }
        
        .element-card.earth {
            border-color: var(--earth);
        }
        
        .element-icon {
            font-size: clamp(3rem, 8vw, 4rem);
            margin-bottom: 15px;
        }
        
        .element-name {
            font-size: clamp(1.4rem, 4.5vw, 1.8rem);
            font-weight: 700;
            margin-bottom: 10px;
        }
        
        .element-description {
            font-size: clamp(0.95rem, 2.8vw, 1.1rem);
            line-height: 1.6;
            color: var(--dark);
            margin-bottom: 15px;
        }
        
        .element-features {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 15px;
        }
        
        .element-feature {
            background-color: var(--section-bg);
            padding: 8px 15px;
            border-radius: 50px;
            font-size: clamp(0.8rem, 2.2vw, 0.9rem);
            color: var(--dark);
        }
        
        .makeup-advice {
            background: var(--section-bg);
            border: 1px solid var(--border);
            padding: 25px;
            border-radius: 15px;
            margin-top: 30px;
        }
        
        .makeup-title {
            font-size: clamp(1.3rem, 4vw, 1.6rem);
            margin-bottom: 20px;
            color: var(--primary);
            font-weight: 700;
            text-align: center;
        }
        
        .makeup-tips {
            font-size: clamp(0.9rem, 2.5vw, 1rem);
            line-height: 1.6;
            color: var(--dark);
        }
        
        .makeup-tips ul {
            margin-left: 20px;
            margin-top: 10px;
        }
        
        .makeup-tips li {
            margin-bottom: 10px;
        }
        
        .action-buttons {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 30px;
            flex-wrap: wrap;
        }
        
        .action-btn {
            padding: 12px 30px;
            border-radius: 50px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            border: 2px solid;
            font-size: clamp(0.9rem, 2.5vw, 1rem);
            touch-action: manipulation;
            -webkit-appearance: none;
            flex: 1;
            min-width: 140px;
            max-width: 200px;
        }
        
        .new-analysis {
            background: white;
            color: var(--primary);
            border-color: var(--primary);
        }
        
        .new-analysis:hover, .new-analysis:active {
            background: var(--primary);
            color: white;
        }
        
        .share {
            background: var(--accent);
            color: white;
            border-color: var(--accent);
        }
        
        .share:hover, .share:active {
            background: #8a9aad;
            transform: translateY(-3px);
            box-shadow: 0 7px 15px rgba(160, 174, 192, 0.3);
        }
        
        .disclaimer {
            text-align: center;
            padding: 25px;
            color: var(--gray);
            font-size: clamp(0.8rem, 2.2vw, 0.95rem);
            line-height: 1.6;
            border-top: 1px solid var(--border);
            margin-top: 40px;
            background-color: var(--section-bg);
            border-radius: 0 0 18px 18px;
        }
        
        /* 新增的详细分析区域样式 */
        .detailed-analysis {
            background: var(--section-bg);
            border: 1px solid var(--border);
            border-radius: 15px;
            padding: 25px;
            margin-top: 30px;
        }
        
        .detailed-title {
            font-size: clamp(1.3rem, 4vw, 1.6rem);
            margin-bottom: 20px;
            color: var(--primary);
            font-weight: 700;
            text-align: center;
        }
        
        .detailed-content {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
            gap: 20px;
        }
        
        .detailed-item {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
        }
        
        .detailed-item-title {
            font-size: clamp(1rem, 3vw, 1.2rem);
            margin-bottom: 10px;
            color: var(--primary);
            font-weight: 600;
            display: flex;
            align-items: center;
        }
        
        .detailed-item-content {
            font-size: clamp(0.8rem, 2.2vw, 0.95rem);
            line-height: 1.5;
            color: var(--dark);
        }
        
        .detailed-item-content ul {
            margin-left: 15px;
            margin-top: 8px;
        }
        
        .detailed-item-content li {
            margin-bottom: 5px;
        }
        
        /* 新增的拖放区域样式 */
        .drop-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(74, 85, 104, 0.8);
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 15px;
            color: white;
            font-size: clamp(1.2rem, 3.5vw, 1.5rem);
            font-weight: 600;
            opacity: 0;
            transition: opacity 0.3s;
            pointer-events: none;
        }
        
        .upload-area.drag-over .drop-overlay {
            opacity: 1;
        }
        
        .flaw-analysis {
            color: var(--danger);
            font-weight: 600;
        }
        
        .strength-analysis {
            color: var(--success);
            font-weight: 600;
        }
        
        .pulse {
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }

        /* 超小屏幕优化 */
        @media (max-width: 480px) {
            .main-content {
                padding: 15px;
            }
            
            .analysis-section, .type-analysis, .five-element-analysis, .makeup-advice, .detailed-analysis {
                padding: 20px 15px;
            }
            
            .feature-grid {
                grid-template-columns: 1fr;
            }
            
            .action-buttons {
                flex-direction: column;
                gap: 15px;
            }
            
            .action-btn {
                width: 100%;
                max-width: none;
            }
        }

        /* 横屏手机优化 */
        @media (max-height: 500px) and (orientation: landscape) {
            body {
                padding: 10px;
            }
            
            .container {
                max-height: 95vh;
                overflow-y: auto;
            }
            
            header {
                padding: 20px 15px;
            }
            
            .main-content {
                padding: 15px;
            }
        }

        /* 平板优化 */
        @media (min-width: 768px) and (max-width: 1024px) {
            .container {
                max-width: 90%;
            }
        }

        /* 防止iOS Safari缩放 */
        @media (max-width: 768px) {
            input, select, textarea {
                font-size: 16px !important;
            }
        }

        /* Mobile-first system typography and touch interactions */
        :root { --primary:#28766c; --secondary:#65a496; --accent:#b5d4cc; --dark:#202b32; --gray:#626e78; --border:#e6ebed; --section-bg:#f5f7fa; --success:#28766c; --danger:#97694b; }
        html { scroll-behavior:smooth; background:#f5f7fa; }
