                    const hashString = file.name + file.size + file.lastModified;
                    let hash = 0;
                    
                    for (let i = 0; i < hashString.length; i++) {
                        const char = hashString.charCodeAt(i);
                        hash = ((hash << 5) - hash) + char;
                        hash = hash & hash; // 转换为32位整数
                    }
                    
                    resolve(Math.abs(hash));
                });
